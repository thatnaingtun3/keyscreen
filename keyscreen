#!/usr/bin/env python3
"""keyscreen - show pressed keys on screen (screenkey replacement that works on Wayland).

Reads keystrokes directly from /dev/input (needs membership in the 'input' group)
and draws them in a transparent, click-through, always-on-top overlay.

Usage: keyscreen [--position bottom-right|bottom-left|bottom|top-right|top-left|top|center] [--margin 40] [--size 16] [--timeout 2.5] [--opacity 0.8] [--layout de]
Stop:  Ctrl+C in the terminal, or `pkill -f keyscreen`
"""
import argparse
import ctypes
import ctypes.util
import os
import selectors
import signal
import subprocess
import sys
import tempfile
import threading
import time

os.environ.setdefault("GDK_BACKEND", "x11")  # XWayland: lets us stay on top & be positioned

try:
    import evdev
    from evdev import ecodes as e
except ImportError:
    sys.exit("python3-evdev missing. Install with:  sudo apt install python3-evdev")

import cairo
import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("Pango", "1.0")
gi.require_version("PangoCairo", "1.0")


def require_cairo():
    """Gtk hands cairo.Context and cairo.Region to our callbacks, so the cairo
    foreign struct converters must be registered before any window is created.
    Without them every draw and click-through call fails with a bare KeyError."""
    try:
        gi.require_foreign("cairo")
    except ImportError:
        sys.exit("python3-gi-cairo missing. Install with:  sudo apt install python3-gi-cairo")


from gi.repository import Gdk, GLib, Gtk, Pango, PangoCairo

# ---------------------------------------------------------------- key names
CHARS = {}
for k, (lo, hi) in {
    **{getattr(e, f"KEY_{c}"): (c.lower(), c) for c in "ABCDEFGHIJKLMNOPQRSTUVWXYZ"},
    e.KEY_1: ("1", "!"), e.KEY_2: ("2", "@"), e.KEY_3: ("3", "#"), e.KEY_4: ("4", "$"),
    e.KEY_5: ("5", "%"), e.KEY_6: ("6", "^"), e.KEY_7: ("7", "&"), e.KEY_8: ("8", "*"),
    e.KEY_9: ("9", "("), e.KEY_0: ("0", ")"), e.KEY_MINUS: ("-", "_"), e.KEY_EQUAL: ("=", "+"),
    e.KEY_LEFTBRACE: ("[", "{"), e.KEY_RIGHTBRACE: ("]", "}"), e.KEY_SEMICOLON: (";", ":"),
    e.KEY_APOSTROPHE: ("'", '"'), e.KEY_GRAVE: ("`", "~"), e.KEY_BACKSLASH: ("\\", "|"),
    e.KEY_COMMA: (",", "<"), e.KEY_DOT: (".", ">"), e.KEY_SLASH: ("/", "?"),
    e.KEY_KP0: ("0", "0"), e.KEY_KP1: ("1", "1"), e.KEY_KP2: ("2", "2"), e.KEY_KP3: ("3", "3"),
    e.KEY_KP4: ("4", "4"), e.KEY_KP5: ("5", "5"), e.KEY_KP6: ("6", "6"), e.KEY_KP7: ("7", "7"),
    e.KEY_KP8: ("8", "8"), e.KEY_KP9: ("9", "9"), e.KEY_KPDOT: (".", "."), e.KEY_KPPLUS: ("+", "+"),
    e.KEY_KPMINUS: ("-", "-"), e.KEY_KPASTERISK: ("*", "*"), e.KEY_KPSLASH: ("/", "/"),
}.items():
    CHARS[k] = (lo, hi)

SPECIAL = {
    e.KEY_ENTER: "⏎", e.KEY_KPENTER: "⏎", e.KEY_BACKSPACE: "⌫", e.KEY_TAB: "⇥",
    e.KEY_ESC: "Esc", e.KEY_SPACE: "␣", e.KEY_DELETE: "Del", e.KEY_INSERT: "Ins",
    e.KEY_HOME: "Home", e.KEY_END: "End", e.KEY_PAGEUP: "PgUp", e.KEY_PAGEDOWN: "PgDn",
    e.KEY_UP: "↑", e.KEY_DOWN: "↓", e.KEY_LEFT: "←", e.KEY_RIGHT: "→",
    e.KEY_CAPSLOCK: "Caps", e.KEY_PRINT: "PrtSc", e.KEY_SYSRQ: "PrtSc",
    e.KEY_VOLUMEUP: "🔊+", e.KEY_VOLUMEDOWN: "🔉−", e.KEY_MUTE: "🔇",
    e.KEY_PLAYPAUSE: "⏯", e.KEY_NEXTSONG: "⏭", e.KEY_PREVIOUSSONG: "⏮",
    e.KEY_BRIGHTNESSUP: "☀+", e.KEY_BRIGHTNESSDOWN: "☀−", e.KEY_COMPOSE: "Menu",
    **{getattr(e, f"KEY_F{i}"): f"F{i}" for i in range(1, 13)},
}

MODS = {
    e.KEY_LEFTCTRL: "Ctrl", e.KEY_RIGHTCTRL: "Ctrl",
    e.KEY_LEFTALT: "Alt", e.KEY_RIGHTALT: "AltGr",
    e.KEY_LEFTSHIFT: "Shift", e.KEY_RIGHTSHIFT: "Shift",
    e.KEY_LEFTMETA: "Super", e.KEY_RIGHTMETA: "Super",
}
MOD_ORDER = ["Ctrl", "Super", "Alt", "AltGr", "Shift"]


# ---------------------------------------------------------------- layouts
# Keys whose own press steers the XKB text state: Shift and Caps Lock change
# characters, AltGr selects the third/fourth level.  Ctrl/Super/Alt are combos,
# not text, so they never reach the state (with Ctrl down, "c" would come back
# as "\x03").
SHIFT_KEYS = {e.KEY_LEFTSHIFT, e.KEY_RIGHTSHIFT}
TEXT_MODIFIERS = SHIFT_KEYS | {e.KEY_RIGHTALT, e.KEY_CAPSLOCK}
XKB_KEYCODE_OFFSET = 8      # evdev keycodes are XKB/X11 keycodes minus 8
XKB_KEY_UP, XKB_KEY_DOWN = 0, 1


class XkbRuleNames(ctypes.Structure):
    """struct xkb_rule_names from <xkbcommon/xkbcommon.h>."""
    _fields_ = [(field, ctypes.c_char_p) for field in
                ("rules", "model", "layout", "variant", "options")]


def active_layout_names():
    """(layout, variant) of the running X11/XWayland keymap, if we can ask."""
    try:
        out = subprocess.run(["setxkbmap", "-query"], capture_output=True,
                             text=True, timeout=2).stdout
    except (OSError, subprocess.SubprocessError):
        return None, None
    found = {}
    for line in out.splitlines():
        key, _, value = line.partition(":")
        if key.strip() in ("layout", "variant"):
            found[key.strip()] = value.strip() or None
    return found.get("layout"), found.get("variant")


class Layout:
    """Turns evdev keycodes into text using the user's real keyboard layout.

    Talks to libxkbcommon through ctypes, so no python binding is needed.  Two
    states are kept: one with Shift applied for the text actually typed, and one
    without it for naming keys in combos (Ctrl+Shift+S, not Ctrl+Shift+s).
    """

    def __init__(self, layout=None, variant=None):
        self._lib = self._keymap = self._state = self._base = None
        self._load(layout, variant)

    @property
    def ok(self):
        return bool(self._state and self._base)

    def _load(self, layout, variant):
        path = ctypes.util.find_library("xkbcommon")
        if not path:
            return
        try:
            lib = ctypes.CDLL(path)
        except OSError:
            return
        lib.xkb_context_new.restype = ctypes.c_void_p
        lib.xkb_context_new.argtypes = [ctypes.c_int]
        lib.xkb_keymap_new_from_names.restype = ctypes.c_void_p
        lib.xkb_keymap_new_from_names.argtypes = [
            ctypes.c_void_p, ctypes.POINTER(XkbRuleNames), ctypes.c_int]
        lib.xkb_state_new.restype = ctypes.c_void_p
        lib.xkb_state_new.argtypes = [ctypes.c_void_p]
        lib.xkb_state_update_key.restype = ctypes.c_int
        lib.xkb_state_update_key.argtypes = [ctypes.c_void_p, ctypes.c_uint32,
                                             ctypes.c_int]
        lib.xkb_state_key_get_utf8.restype = ctypes.c_int
        lib.xkb_state_key_get_utf8.argtypes = [ctypes.c_void_p, ctypes.c_uint32,
                                               ctypes.c_char_p, ctypes.c_size_t]
        ctx = lib.xkb_context_new(0)    # XKB_CONTEXT_NO_FLAGS
        if not ctx:
            return
        names = XkbRuleNames(None, None,
                             layout.encode() if layout else None,
                             variant.encode() if variant else None, None)
        keymap = lib.xkb_keymap_new_from_names(ctx, ctypes.byref(names), 0)
        if not keymap:      # unknown --layout name: keep the fallback table
            return
        self._lib, self._keymap = lib, keymap
        self._state = lib.xkb_state_new(keymap)
        self._base = lib.xkb_state_new(keymap)

    def _utf8(self, state, code):
        buf = ctypes.create_string_buffer(64)
        keycode = code + XKB_KEYCODE_OFFSET
        if self._lib.xkb_state_key_get_utf8(state, keycode, buf, len(buf)):
            return buf.value.decode("utf-8", "replace")
        return ""

    def update(self, code, down):
        """Feed a Shift/AltGr/Caps Lock press or release into the states."""
        if not self.ok or code not in TEXT_MODIFIERS:
            return
        keycode = code + XKB_KEYCODE_OFFSET
        state = XKB_KEY_DOWN if down else XKB_KEY_UP
        self._lib.xkb_state_update_key(self._state, keycode, state)
        if code not in SHIFT_KEYS:      # the naming state ignores Shift
            self._lib.xkb_state_update_key(self._base, keycode, state)

    def text(self, code):
        """What this key types right now ('' for e.g. arrows)."""
        return self._utf8(self._state, code) if self.ok else ""

    def base(self, code):
        """What this key types with Shift released."""
        return self._utf8(self._base, code) if self.ok else ""


def printable_text(text):
    """True for text worth showing as characters (not CR, Tab, NUL...)."""
    return bool(text) and text.isprintable() and not text.isspace()


# ---------------------------------------------------------------- input reader
class KeyReader(threading.Thread):
    def __init__(self, on_key, layout=None):
        super().__init__(daemon=True)
        self.on_key = on_key
        self.layout = layout
        self.sel = selectors.DefaultSelector()
        self.devices = {}
        self.held = {}  # keycode -> mod name

    def scan(self):
        for path in evdev.list_devices():
            if path in self.devices:
                continue
            try:
                dev = evdev.InputDevice(path)
                keys = dev.capabilities().get(e.EV_KEY, [])
                if e.KEY_A in keys or e.KEY_ENTER in keys:   # looks like a keyboard
                    self.devices[path] = dev
                    self.sel.register(dev, selectors.EVENT_READ)
                else:
                    dev.close()
            except (PermissionError, OSError):
                pass

    def run(self):
        last_scan = 0
        while True:
            if time.time() - last_scan > 3:   # pick up hot-plugged keyboards
                self.scan()
                last_scan = time.time()
            for key, _ in self.sel.select(timeout=1):
                dev = key.fileobj
                try:
                    for ev in dev.read():
                        if ev.type == e.EV_KEY:
                            self.handle(ev.code, ev.value)
                except OSError:  # unplugged
                    self.sel.unregister(dev)
                    self.devices.pop(dev.path, None)

    def char(self, code):
        """The text this key types, or '' for keys that type nothing."""
        if code == e.KEY_SPACE:
            return "␣"      # a bare space would be invisible in the overlay
        text = self.layout.text(code) if self.layout else ""
        if printable_text(text):
            return text
        if code in CHARS:   # keypad digits, or no XKB data on this system
            return CHARS[code][1 if "Shift" in self.held.values() else 0]
        return ""

    def key_name(self, code):
        """Display name of a key inside a combo (Ctrl+C, Alt+Tab...)."""
        if code == e.KEY_SPACE:
            return "␣"
        text = self.layout.base(code) if self.layout else ""
        if printable_text(text) and len(text) == 1:
            return text.upper()
        if not printable_text(text) and code in CHARS:
            return CHARS[code][0].upper()
        name = SPECIAL.get(code)
        if name:
            return name
        name = e.KEY.get(code, f"key{code}")
        name = name[0] if isinstance(name, list) else name
        return name.replace("KEY_", "").title()

    def handle(self, code, value):
        if self.layout and code in TEXT_MODIFIERS:
            self.layout.update(code, value != 0)
        if code in MODS:
            if value == 1:
                self.held[code] = MODS[code]
            elif value == 0:
                self.held.pop(code, None)
            return
        if value != 1:      # release (0), or autorepeat (2) from a held key
            return
        mods = set(self.held.values())
        shift = "Shift" in mods
        combo_mods = [m for m in MOD_ORDER if m in mods and m != "Shift"]
        text = self.char(code)
        if text and not combo_mods:
            self.on_key(text, True)     # plain typing (shift just changes the char)
            return
        parts = combo_mods + (["Shift"] if shift else []) + [self.key_name(code)]
        self.on_key("+".join(parts), False)


# ---------------------------------------------------------------- overlay
class Overlay(Gtk.Window):
    def __init__(self, args):
        super().__init__(type=Gtk.WindowType.POPUP)
        self.args = args
        self.items = []          # list of [text, is_typing]
        self.last = 0
        self.alpha = 0.0
        self.set_app_paintable(True)
        visual = self.get_screen().get_rgba_visual()
        if visual:
            self.set_visual(visual)
        self.set_keep_above(True)
        self.set_accept_focus(False)
        self.connect("draw", self.on_draw)
        self.connect("realize", lambda w: w.input_shape_combine_region(cairo.Region()))  # click-through
        self.font = Pango.FontDescription(f"Sans Bold {args.size}")
        GLib.timeout_add(50, self.tick)

    def add(self, text, typing):
        now = time.time()
        if now - self.last > self.args.timeout:
            self.items = []
        if typing and self.items and self.items[-1][1]:
            self.items[-1][0] += text
        else:
            self.items.append([text, typing])
        self.last = now
        self.alpha = 1.0
        self.relayout()
        return False

    def label(self):
        s = "  ".join(t for t, _ in self.items)
        return s[-self.args.max_chars:]

    def relayout(self):
        layout = self.create_pango_layout(self.label() or " ")
        layout.set_font_description(self.font)
        tw, th = layout.get_pixel_size()
        pad = int(self.args.size * 0.45)
        w, h = tw + pad * 2, th + pad
        self._layout, self._pad = layout, pad
        mon = Gdk.Display.get_default().get_primary_monitor() or \
            Gdk.Display.get_default().get_monitor(0)
        g = mon.get_geometry()
        pos, m = self.args.position, self.args.margin
        if pos.endswith("right"):
            x = g.x + g.width - w - m
        elif pos.endswith("left"):
            x = g.x + m
        else:
            x = g.x + (g.width - w) // 2
        if pos.startswith("top"):
            y = g.y + 60
        elif pos == "center":
            y = g.y + (g.height - h) // 2
        else:
            y = g.y + g.height - h - 100
        self.resize(w, h)
        self.move(x, y)
        self.show_all()
        self.queue_draw()

    def tick(self):
        if self.items and time.time() - self.last > self.args.timeout:
            self.alpha -= 0.08
            if self.alpha <= 0:
                self.items = []
                self.hide()
            else:
                self.queue_draw()
        return True

    def on_draw(self, w, cr):
        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.set_source_rgba(0, 0, 0, 0)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)
        W, H = self.get_size()
        r = min(10, H / 2)
        cr.new_sub_path()
        cr.arc(W - r, r, r, -1.5708, 0)
        cr.arc(W - r, H - r, r, 0, 1.5708)
        cr.arc(r, H - r, r, 1.5708, 3.1416)
        cr.arc(r, r, r, 3.1416, 4.7124)
        cr.close_path()
        cr.set_source_rgba(0.08, 0.08, 0.1, self.args.opacity * self.alpha)
        cr.fill()
        cr.set_source_rgba(1, 1, 1, self.alpha)
        cr.move_to(self._pad, self._pad / 2)
        PangoCairo.show_layout(cr, self._layout)
        return True


def main():
    p = argparse.ArgumentParser(
        prog="keyscreen",
        description="Show keystrokes on screen (Wayland-friendly).",
        epilog="examples:\n"
               "  keyscreen                                    auto-detect the layout\n"
               "  keyscreen --position top-left --size 20\n"
               "  keyscreen --layout fr --variant nodeadkeys\n"
               "  keyscreen --timeout 1.5 --opacity 0.6\n"
               "\n"
               "Your user must be in the 'input' group to read /dev/input; the .deb\n"
               "installer adds it (log out and back in for it to take effect).",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument("--position", default="bottom-right", metavar="POS",
                   choices=["bottom", "bottom-right", "bottom-left",
                            "top", "top-right", "top-left", "center"],
                   help="where the overlay sits: top-left, top, top-right, "
                        "center, bottom-left, bottom, bottom-right "
                        "(default: bottom-right)")
    p.add_argument("--margin", type=int, default=40, metavar="PX",
                   help="gap from the screen edge, for left/right positions (default: 40)")
    p.add_argument("--size", type=int, default=16, metavar="PT",
                   help="font size (default: 16)")
    p.add_argument("--timeout", type=float, default=2.5, metavar="SEC",
                   help="seconds before it fades (default: 2.5)")
    p.add_argument("--opacity", type=float, default=0.8, metavar="0-1",
                   help="background opacity (default: 0.8)")
    p.add_argument("--max-chars", type=int, default=20, metavar="N",
                   help="keep only the last N characters of history (default: 20)")
    p.add_argument("--layout", metavar="NAME",
                   help="keyboard layout for key names, e.g. de or fr "
                        "(default: auto-detect)")
    p.add_argument("--variant", metavar="NAME",
                   help="layout variant, e.g. nodeadkeys (default: none)")
    args = p.parse_args()
    require_cairo()  # --help works without it; drawing and click-through do not

    layout, variant = args.layout, args.variant
    if not layout:
        layout, variant = active_layout_names()
    keyboard = Layout(layout, variant)
    if not keyboard.ok:
        print("Note: no usable XKB layout found, falling back to a US key map.",
              file=sys.stderr)

    overlay = Overlay(args)
    reader = KeyReader(lambda t, typing: GLib.idle_add(overlay.add, t, typing),
                       keyboard)
    reader.scan()
    if not reader.devices:
        sys.exit("No readable keyboard found in /dev/input.\n"
                 "Add yourself to the input group:  sudo usermod -aG input $USER\n"
                 "then log out and log back in.")
    print(f"keyscreen running ({len(reader.devices)} keyboard device(s)). Ctrl+C to quit.")
    # proves to keyscreen-toggle which process to stop, wherever it was started from
    pidfile = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir(),
                           "keyscreen.pid")
    try:
        with open(pidfile, "w") as fh:
            fh.write(f"{os.getpid()}\n")
        reader.start()
        for sig in (signal.SIGINT, signal.SIGTERM):
            GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, sig, Gtk.main_quit)
        Gtk.main()
    finally:
        try:
            os.unlink(pidfile)
        except OSError:
            pass


if __name__ == "__main__":
    main()
